# Required. Random string, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Optional: fixed admin password. If empty, the first visit to /admin runs a setup.
ADMIN_PASSWORD=

# Required for the AI summary of free-text answers
ANTHROPIC_API_KEY=

# Port the server listens on (Coolify: 3000). Locally use a free port, 3000 is taken by Docker.
PORT=3210
API_PORT=3210

# Data directory for the SQLite file (container: /app/data)
DATA_DIR=./data
